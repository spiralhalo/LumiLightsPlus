{
	images: [
		{
			name: "gen_nature_tex",
			lod: 0,
			size: 1024,
			internalFormat: "RGB8",
			pixelFormat: "RGB",
			pixelDataType: "UNSIGNED_BYTE",
			target: "TEXTURE_2D",
			texParams: [ 
				{name: "TEXTURE_MIN_FILTER", val: "LINEAR"}, {name: "TEXTURE_MAG_FILTER", val: "LINEAR"},
				{name: "TEXTURE_WRAP_S", val: "REPEAT"}, {name: "TEXTURE_WRAP_T", val: "REPEAT"},
			]
		},
	],

	framebuffers: [
		{
			name: "gentex",
			colorAttachments: [
				{image: "gen_nature_tex", clearColor: 0x00000000}
			]
		}
	],

	programs: [
		{
			name: "gentex",
			vertexSource: "lumi:shaders/mtn/gentex.glsl",
			fragmentSource: "lumi:shaders/mtn/gentex.glsl",
			samplers: []
		}
	],

	onInit: {
		passes: [
			{
				name: "gentex",
				program: "gentex",
				framebuffer: "gentex",
				width: 1024,
				height: 1024,
				samplerImages: []
			},
		]
	},
}
